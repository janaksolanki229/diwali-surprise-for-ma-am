      <h1>Shubh Deepawali,<br>Ma’am!</h1>
      <textarea id="diwaliMsg"
        placeholder="Write your personal Diwali message here…">Ma’am, wishing you a Diwali filled with light, peace, happiness, and beautiful memories. May the coming year bring you success in everything you do and many moments that make you smile.Ma’am, just as the return of Prabhu Shree Ram filled Ayodhya with the light of countless diyas, may His divine presence always illuminate your heart and your life. May He fill your days with endless happiness, peace, and countless beautiful reasons to smile. And whenever life feels heavy, may His blessings gently ease your sorrows, replacing every sadness with hope, warmth, and joy. May your heart always remain as bright as Ayodhya on the night of His return. 🪔✨ Happy Diwali!</textarea>
      <p style="color:#f7d17a;font-style:italic">With lots of respect,<br>Janak</p>
      <button class="btn" onclick="go(0)">Replay the celebration ↺</button>
      <footer>HAPPY DIWALI • LIGHT • PEACE • JOY</footer>
    </div>
  </div>

  <script>
    let bgMusic = document.getElementById('bgMusic');
    let pujaMusic = document.getElementById('pujaMusic');
    let isMuted = false;
    let userHasInteracted = false;

    function playBgMusic() {
      if (isMuted) return;
      pujaMusic.pause();
      bgMusic.play().catch(() => { });
    }

    function playPujaMusic() {
      if (isMuted) return;
      bgMusic.pause();
      pujaMusic.currentTime = 0;
      pujaMusic.play().catch(() => { });
    }

    function toggleMute() {
      isMuted = !isMuted;
      let btn = document.getElementById('musicToggle');
      if (isMuted) {
        bgMusic.pause();
        pujaMusic.pause();
        btn.innerHTML = '🔇 Music: Off';
        btn.classList.add('muted');
      } else {
        btn.innerHTML = '🎵 Music: On';
        btn.classList.remove('muted');
        let active = document.querySelector('.screen.active');
        if (active && active.id === 's4') {
          pujaMusic.play().catch(() => { });
        } else {
          bgMusic.play().catch(() => { });
        }
      }
    }

    function go(n) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      let el = document.getElementById('s' + n);
      if (el) el.classList.add('active');

      userHasInteracted = true;
      if (n === 4) {
        // Lakshmi Puja screen: ONLY play eso-ma-lokkhi-boso-ghore.mp3
        playPujaMusic();
        startAarti();
        startFlowers();
      } else {
        // All other screens: play alo-amar-alo-ogo.mp3
        playBgMusic();
      }

      if (n === 6) {
        setTimeout(setupScratch, 60);
      }

      if (n === 7 || n === 8) {
        document.querySelectorAll('#s' + n + ' .finale-video').forEach(v => {
          v.currentTime = 0;
          v.play().catch(() => { });
        });
      }
    }

    const diyasLit = new Set();
    function lightDiya(index) {
      const el = document.querySelectorAll('.diya-touch')[index];
      if (!el || diyasLit.has(index)) return;
      diyasLit.add(index);
      el.classList.add('lit');
      el.setAttribute('aria-pressed', 'true');
      document.getElementById('diyaCount').textContent = diyasLit.size + ' of 5 diyas lit';
      if (diyasLit.size === 5) {
        document.getElementById('diyaInstruction').textContent = 'All five diyas are glowing. Shubh Deepawali! ✨';
        document.getElementById('continueDiyas').disabled = false;
      }
      if (!isMuted && bgMusic.paused) playBgMusic();
    }

    // Rangoli Interactive Logic
    const rangoliColors = [
      { name: 'Rani Pink', hex: '#e91e63' },
      { name: 'Saffron Orange', hex: '#ff7a00' },
      { name: 'Haldi Yellow', hex: '#ffd600' },
      { name: 'Emerald Green', hex: '#00e676' },
      { name: 'Peacock Cyan', hex: '#00e5ff' },
      { name: 'Lotus Purple', hex: '#ba68c8' },
      { name: 'Sindoor Red', hex: '#d50000' },
      { name: 'Sacred White', hex: '#ffffff' }
    ];

    let selectedColor = '#ff7a00';
    let symmetryMode = true;
    let activeRangoliPart = null;

    function initRangoliPalette() {
      const container = document.getElementById('rangoliPalette');
      if (!container) return;
      container.innerHTML = '';
      rangoliColors.forEach((c) => {
        const btn = document.createElement('button');
        btn.className = 'color-swatch' + (c.hex === selectedColor ? ' active' : '');
        btn.style.backgroundColor = c.hex;
        btn.style.setProperty('--swatch-color', c.hex);
        btn.setAttribute('aria-label', c.name);
        btn.title = c.name;
        btn.onclick = () => selectColor(c.hex, btn);
        container.appendChild(btn);
      });
    }

    function selectColor(hex, btnEl) {
      selectedColor = hex;
      document.querySelectorAll('.color-swatch').forEach(b => b.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');

      if (activeRangoliPart) {
        applyColorToPart(activeRangoliPart, hex);
        activeRangoliPart = null;
        document.querySelectorAll('.rangoli-part').forEach(p => p.classList.remove('selected-target'));
      }
    }

    function colorPart(el) {
      if (selectedColor) {
        applyColorToPart(el, selectedColor);
      } else {
        document.querySelectorAll('.rangoli-part').forEach(p => p.classList.remove('selected-target'));
        activeRangoliPart = el;
        el.classList.add('selected-target');
        let status = document.getElementById('rangoliStatus');
        if (status) status.textContent = 'Touch a color above to paint this section!';
      }
      if (!isMuted && bgMusic.paused) playBgMusic();
    }

    function applyColorToPart(el, hex) {
      const group = el.getAttribute('data-group');
      let targets = [el];
      if (symmetryMode && group) {
        targets = Array.from(document.querySelectorAll(`[data-group="${group}"]`));
      }
      targets.forEach(t => {
        if (t.tagName.toLowerCase() === 'g') {
          t.querySelectorAll('.part-shape').forEach(s => s.style.fill = hex);
        } else {
          t.style.fill = hex;
        }
        t.style.filter = 'drop-shadow(0 0 6px ' + hex + ')';
        setTimeout(() => { t.style.filter = ''; }, 400);
      });
      let status = document.getElementById('rangoliStatus');
      if (status) status.textContent = '✨ Beautiful! Keep coloring or proceed to Dhanteras.';
    }

    function toggleSymmetry() {
      symmetryMode = !symmetryMode;
      const btn = document.getElementById('symmetryBtn');
      if (symmetryMode) {
        btn.textContent = '✨ Symmetrical: ON';
        btn.classList.add('active');
      } else {
        btn.textContent = '✨ Single Petal';
        btn.classList.remove('active');
      }
    }

    function magicFillRangoli() {
      const magicMap = {
        'center-core': '#d50000',
        'center-ring': '#ffd600',
        'inner-petals': '#ff7a00',
        'middle-diamonds': '#00e676',
        'outer-petals': '#e91e63',
        'scallops': '#00e5ff',
        'tip-bindis': '#ffd600',
        'corner-diyas': '#ff9800'
      };
      Object.keys(magicMap).forEach(grp => {
        const col = magicMap[grp];
        document.querySelectorAll(`[data-group="${grp}"]`).forEach(t => {
          if (t.tagName.toLowerCase() === 'g') {
            t.querySelectorAll('.part-shape').forEach(s => s.style.fill = col);
          } else {
            t.style.fill = col;
          }
        });
      });
      let status = document.getElementById('rangoliStatus');
      if (status) status.textContent = '✨ Rangoli filled with royal festive colors!';
    }

    function resetRangoli() {
      const defaultFill = '#231238';
      document.querySelectorAll('.rangoli-part').forEach(t => {
        if (t.tagName.toLowerCase() === 'g') {
          t.querySelectorAll('.part-shape').forEach(s => s.style.fill = defaultFill);
        } else {
          t.style.fill = defaultFill;
        }
      });
      let status = document.getElementById('rangoliStatus');
      if (status) status.textContent = 'Rangoli cleared. Touch any petal to start coloring!';
    }

    // Aarti
    let aartiStarted = false;
    function startAarti() {
      if (aartiStarted) return;
      aartiStarted = true;
      let thaliWrap = document.getElementById('thaliWrap');
      if (thaliWrap) thaliWrap.style.display = 'flex';
      let next = document.getElementById('afterAarti');
      if (next) next.style.display = 'inline-block';
      let btn = document.getElementById('aartiBtn');
      if (btn) {
        btn.textContent = 'Aarti in progress 🪔';
        btn.disabled = true;
      }
      let note = document.getElementById('audioNote');
      if (note) note.textContent = '॥ এসো মা লক্ষ্মী বসো ঘরে ॥ Aarti is playing.';
      playPujaMusic();
    }

    // Fireworks
    function fireworks() {
      const title = document.getElementById('fireworksText');
      if (title) {
        title.style.display = 'block';
        title.innerHTML = '✨🎆 SHUBH DEEPAWALI 🎆✨';
      }
      const fx = document.getElementById('fx'), c = fx.getContext('2d');
      fx.width = innerWidth;
      fx.height = innerHeight;
      let particles = [], rockets = [], launches = 0;
      const colors = ['#ffd76a', '#ff4d75', '#ff9b45', '#7deaff', '#d7a0ff', '#fff5d6', '#8dffb2'];
      function burst(x, y, color, grand = false) {
        const n = grand ? 190 : 120;
        for (let i = 0; i < n; i++) {
          let ang = Math.random() * Math.PI * 2, sp = (grand ? 2.5 : 1.5) + Math.random() * (grand ? 7 : 5);
          particles.push({ x, y, px: x, py: y, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp, life: 65 + Math.random() * 65, max: 130, color, size: .8 + Math.random() * 2.3, gravity: .025 + Math.random() * .04 });
        }
      }
      function launch() {
        if (launches++ >= 15) return;
        let x = fx.width * (.1 + Math.random() * .8), ty = fx.height * (.12 + Math.random() * .5), col = colors[Math.floor(Math.random() * colors.length)];
        rockets.push({ x, y: fx.height + 5, ty, v: 5 + Math.random() * 3, color: col });
        setTimeout(launch, 240 + Math.random() * 480);
      }
      launch();
      function tick() {
        c.fillStyle = 'rgba(2,2,12,.18)';
        c.fillRect(0, 0, fx.width, fx.height);
        rockets = rockets.filter(r => {
          r.y -= r.v;
          c.strokeStyle = r.color;
          c.lineWidth = 2;
          c.globalAlpha = .8;
          c.beginPath();
          c.moveTo(r.x, r.y + 22);
          c.lineTo(r.x, r.y);
          c.stroke();
          if (r.y < r.ty) {
            burst(r.x, r.y, r.color, Math.random() < .45);
            return false;
          }
          return true;
        });
        particles = particles.filter(p => {
          p.px = p.x; p.py = p.y;
          p.x += p.vx; p.y += p.vy;
          p.vy += p.gravity; p.vx *= .986;
          p.life--;
          c.globalAlpha = Math.max(0, p.life / p.max);
          c.strokeStyle = p.color;
          c.lineWidth = p.size;
          c.beginPath();
          c.moveTo(p.px, p.py);
          c.lineTo(p.x, p.y);
          c.stroke();
          return p.life > 0;
        });
        c.globalAlpha = 1;
        if (rockets.length || particles.length || launches <= 15) requestAnimationFrame(tick);
        else setTimeout(() => c.clearRect(0, 0, fx.width, fx.height), 1500);
      }
      tick();
    }

    // Stars background
    let sc = document.getElementById('stars'), ctx = sc.getContext('2d'), stars = [];
    function resize() {
      sc.width = innerWidth; sc.height = innerHeight;
      stars = Array.from({ length: 120 }, () => ({ x: Math.random() * sc.width, y: Math.random() * sc.height, r: .3 + Math.random() * 1.5, p: Math.random() * 6 }));
    }
    function draw() {
      ctx.clearRect(0, 0, sc.width, sc.height);
      stars.forEach(s => {
        s.p += .02;
        ctx.globalAlpha = .15 + .6 * (Math.sin(s.p) + 1) / 2;
        ctx.fillStyle = '#ffe7ac';
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;
      requestAnimationFrame(draw);
    }
    resize(); draw(); addEventListener('resize', resize);

    // Flower Petals for Lakshmi Puja
    let flowersStarted = false;
    function startFlowers() {
      if (flowersStarted) return;
      flowersStarted = true;
      let root = document.getElementById('petals');
      if (!root) return;
      for (let i = 0; i < 90; i++) {
        let p = document.createElement('span');
        p.className = 'petal';
        p.textContent = ['🌺', '🌸', '🌼', '🪷'][Math.floor(Math.random() * 4)];
        p.style.left = (Math.random() * 100) + '%';
        p.style.animationDuration = (3.5 + Math.random() * 4.5) + 's';
        p.style.animationDelay = (Math.random() * 2) + 's';
        p.style.setProperty('--drift', (Math.random() * 200 - 100) + 'px');
        root.appendChild(p);
        setTimeout(() => p.remove(), 9000);
      }
    }

    // Scratch Card
    let canvas = document.getElementById('scratchCanvas'), cc = canvas.getContext('2d'), scratching = false;
    let scratchReady = false;
    function setupScratch() {
      let r = canvas.getBoundingClientRect();
      if (r.width === 0 || r.height === 0) return;
      scratchReady = true;
      canvas.width = r.width * devicePixelRatio;
      canvas.height = r.height * devicePixelRatio;
      cc.scale(devicePixelRatio, devicePixelRatio);

      let grad = cc.createLinearGradient(0, 0, r.width, r.height);
      grad.addColorStop(0, '#9c6724');
      grad.addColorStop(0.3, '#f5d67f');
      grad.addColorStop(0.7, '#8f4f1d');
      grad.addColorStop(1, '#e8be63');
      cc.fillStyle = grad;
      cc.fillRect(0, 0, r.width, r.height);

      cc.fillStyle = '#220e28';
      let fontSize = Math.max(15, Math.min(22, r.width * 0.05));
      cc.font = 'bold ' + fontSize + 'px Georgia, serif';
      cc.textAlign = 'center';
      cc.textBaseline = 'middle';
      cc.shadowColor = '#ffeaa7';
      cc.shadowBlur = 8;
      cc.fillText('✨ SCRATCH HERE ✨', r.width / 2, r.height / 2);
      cc.shadowBlur = 0;
      cc.globalCompositeOperation = 'destination-out';
    }
    setupScratch();

    function scratch(e) {
      if (!scratching) return;
      let r = canvas.getBoundingClientRect();
      let x = (e.clientX - r.left), y = (e.clientY - r.top);
      let brushRadius = Math.max(24, Math.min(36, r.width * 0.065));
      cc.beginPath();
      cc.arc(x, y, brushRadius, 0, Math.PI * 2);
      cc.fill();
    }
    canvas.addEventListener('pointerdown', e => { scratching = true; canvas.setPointerCapture(e.pointerId); scratch(e); });
    canvas.addEventListener('pointermove', scratch);
    canvas.addEventListener('pointerup', () => scratching = false);
    canvas.addEventListener('pointercancel', () => scratching = false);

    // Init on load
    initRangoliPalette();
  </script>
</body>

</html>