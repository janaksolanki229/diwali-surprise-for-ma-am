<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>A Diwali Surprise for Ma'am</title>
  <style>
    :root {
      --gold: #f7d17a;
      --cream: #fff2d8;
      --pink: #e8a9bf;
      --purple: #180c30;
      --wine: #35113d
    }

    * {
      box-sizing: border-box
    }

    html {
      scroll-behavior: smooth
    }

    body {
      margin: 0;
      background: #09071b;
      color: var(--cream);
      font-family: Georgia, 'Times New Roman', serif;
      overflow: hidden
    }

    #bg {
      position: fixed;
      inset: 0;
      background: url("diwali_background.jpeg") center center / cover no-repeat;
      z-index: -3
    }

    #stars,
    #fx {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 5
    }

    .screen {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100svh;
      min-height: 100svh;
      display: none;
      align-items: center;
      justify-content: center;
      padding: clamp(10px, 2vw, 24px);
      overflow: auto;
      background: radial-gradient(ellipse at 50% 40%, #4b235b 0%, #211033 48%, #080719 100%)
    }

    .screen.active {
      display: flex;
      animation: fade .25s ease
    }

    .panel {
      width: 100%;
      height: 100%;
      min-height: calc(100svh - 20px);
      max-width: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: clamp(16px, 4vw, 48px);
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      position: relative;
      overflow-y: auto
    }

    .screen .panel>* {
      max-width: min(900px, 100%)
    }

    .kicker {
      font: 11px/1.5 Arial, sans-serif;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--gold)
    }

    h1 {
      font-size: clamp(2.4rem, 8vw, 5.5rem);
      font-weight: normal;
      line-height: 1.04;
      margin: 16px 0;
      color: var(--gold);
      text-shadow: 0 0 28px #ffca6755
    }

    h2 {
      font-size: clamp(1.8rem, 6vw, 3.5rem);
      font-weight: normal;
      color: var(--gold);
      margin: 12px 0 20px
    }

    p {
      font-size: clamp(1rem, 2.5vw, 1.2rem);
      line-height: 1.8;
      color: #ffefd9;
      margin: 14px auto;
      max-width: 700px
    }

    .small {
      font-size: .9rem;
      color: #d9c6e2
    }

    .orn {
      font-size: clamp(30px, 7vw, 55px);
      margin: 16px
    }

    .btn {
      border: 1px solid var(--gold);
      color: var(--gold);
      background: #f7d17a12;
      border-radius: 999px;
      padding: 13px 22px;
      font: 13px Arial, sans-serif;
      letter-spacing: .08em;
      cursor: pointer;
      margin: 10px 5px;
      transition: .25s
    }

    .btn:hover {
      transform: translateY(-2px);
      background: #f7d17a26;
      box-shadow: 0 0 20px #f7d17a20
    }

    .btn.primary {
      background: linear-gradient(120deg, #9c6724, #e8bd61);
      color: #24102e;
      border: 0
    }

    textarea {
      display: block;
      width: min(650px, 100%);
      margin: 18px auto;
      padding: 14px;
      border-radius: 14px;
      background: #120921aa;
      border: 1px solid #f7d17a66;
      color: #fff0d8;
      font: 16px Georgia;
      line-height: 1.5;
      resize: vertical;
      min-height: 100px
    }

    .photo-row {
      display: flex;
      gap: 16px;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      margin: 20px auto
    }

    .photo-box {
      width: min(37vw, 230px);
      height: min(42vw, 260px);
      min-width: 140px;
      min-height: 170px;
      border: 1px solid #f7d17a88;
      border-radius: 22px;
      overflow: hidden;
      background: linear-gradient(160deg, #5c2a5d, #1b0d30);
      display: grid;
      place-items: center;
      position: relative;
      box-shadow: 0 0 30px #f7d17a16
    }

    .photo-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none
    }

    .photo-box .placeholder {
      padding: 15px;
      color: #f8d98e;
      font-size: 14px
    }

    .photo-box label {
      position: absolute;
      bottom: 8px;
      left: 8px;
      right: 8px;
      background: #120921d9;
      border: 1px solid #f7d17a77;
      border-radius: 12px;
      padding: 9px;
      font: 11px Arial, sans-serif;
      color: #ffe4a3;
      cursor: pointer
    }

    .photo-box input {
      display: none
    }

    .puja {
      background: radial-gradient(ellipse at center, #54275d 0, #25113c 48%, #09071b 100%)
    }

    .puja .panel {
      max-width: 980px;
      overflow: hidden
    }

    #petals {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 2
    }

    .petal {
      position: absolute;
      top: -40px;
      font-size: 22px;
      animation: petalFall linear forwards;
      filter: drop-shadow(0 0 7px #ff4568)
    }

    @keyframes petalFall {
      to {
        transform: translate3d(var(--drift), 110vh, 0) rotate(720deg);
        opacity: .1
      }
    }

    .offer {
      height: 92px;
      position: relative;
      margin: 8px auto 0;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      transform: translateY(18px);
      transition: 1.2s
    }

    .offer.show {
      opacity: 1;
      transform: none
    }

    .hand {
      font-size: 50px;
      display: inline-block;
      animation: offer 2.3s ease-in-out infinite
    }

    .sunflower {
      font-size: 52px;
      margin-left: -5px;
      display: inline-block;
      filter: drop-shadow(0 0 14px #ffc84b);
      animation: flowerGlow 1.7s alternate infinite
    }

    @keyframes offer {

      0%,
      100% {
        transform: translateX(-12px) rotate(-5deg)
      }

      50% {
        transform: translateX(12px) rotate(4deg)
      }
    }

    @keyframes flowerGlow {
      to {
        filter: drop-shadow(0 0 22px #ffdd68);
        transform: scale(1.08)
      }
    }

    .aarti-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 18px auto;
      height: 110px
    }

    .thali {
      font-size: 62px;
      filter: drop-shadow(0 0 16px #ffc85a);
      animation: rotateThali 5s linear infinite;
      transform-origin: center
    }

    @keyframes rotateThali {
      to {
        transform: rotate(360deg)
      }
    }

    .audio-note {
      font: 12px Arial, sans-serif;
      color: #d9c6e2;
      margin: 10px
    }

    .scratch {
      width: min(580px, 92vw);
      aspect-ratio: 1024 / 558;
      max-height: min(340px, 48vh);
      margin: 16px auto;
      border: 2px solid #f7d17abb;
      border-radius: 22px;
      position: relative;
      overflow: hidden;
      background: #150926;
      box-shadow: 0 0 35px rgba(247, 209, 122, 0.3), 0 10px 32px rgba(0, 0, 0, 0.8);
      touch-action: none
    }

    .scratch .under {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden
    }

    .scratch-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block
    }

    .scratch canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      cursor: crosshair;
      touch-action: none
    }

    .fireworks {
      font-size: clamp(2rem, 8vw, 5rem);
      letter-spacing: .2em;
      animation: pop .8s ease infinite alternate
    }

    @keyframes pop {
      to {
        transform: scale(1.08);
        filter: drop-shadow(0 0 25px #ffd96a)
      }
    }

    footer {
      font: 10px Arial, sans-serif;
      letter-spacing: .2em;
      color: #c7b4d4;
      margin-top: 24px
    }

    @keyframes fade {
      from {
        opacity: .4;
        transform: translateY(6px)
      }

      to {
        opacity: 1;
        transform: none
      }
    }


    #s7,
    #s8 {
      background: #05040d;
      isolation: isolate
    }

    #s7 .finale-video,
    #s8 .finale-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -2
    }

    #s7:after,
    #s8:after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, #05040d66 0%, #07040b20 38%, #07040b99 100%);
      z-index: -1;
      pointer-events: none
    }

    #s7 .panel,
    #s8 .panel {
      min-height: 100svh;
      justify-content: center
    }

    #s7 .kicker,
    #s8 .kicker {
      color: #ffe6a4;
      text-shadow: 0 2px 12px #000
    }

    #s7 h2,
    #s8 h1 {
      color: #fff2cf;
      text-shadow: 0 0 18px #ffbd5a, 0 0 45px #ff3e5e, 0 3px 16px #000;
      font-size: clamp(2.6rem, 10vw, 6.4rem)
    }

    #s7 p,
    #s8 p {
      color: #fff8ed;
      text-shadow: 0 2px 12px #000;
      font-size: clamp(1rem, 3vw, 1.35rem)
    }

    #s7 .btn,
    #s8 .btn {
      background: #180c30a8;
      backdrop-filter: blur(5px);
      border-color: #ffe19a;
      color: #ffe8b0
    }

    #s7 .fireworks {
      font-size: clamp(1.8rem, 7vw, 5rem);
      letter-spacing: .03em;
      color: #fff2c4;
      text-shadow: 0 0 20px #ffb94c
    }


    #s0 {
      background: radial-gradient(ellipse at 50% 30%, #301438 0%, #170b24 55%, #090614 100%) !important;
      isolation: isolate
    }

    #s0.active {
      animation: none;
      display: flex
    }

    #s0 .panel {
      min-height: 100svh;
      justify-content: center;
      position: relative
    }

    #s0 .ram-opening h1 {
      letter-spacing: .025em;
      text-shadow: 0 0 24px #ff9e3d, 0 0 55px #a43d16, 0 3px 14px #000
    }

    #s0 .ram-opening .kicker,
    #s0 .ram-opening footer {
      color: #ffd98b;
      text-shadow: 0 2px 10px #000
    }

    .ram-photo-card {
      margin: 14px auto;
      width: min(92vw, 640px);
      display: flex;
      justify-content: center
    }

    .ram-photo-frame {
      position: relative;
      width: 100%;
      border-radius: 20px;
      overflow: hidden;
      border: 2px solid #f7d17abb;
      box-shadow: 0 0 35px rgba(247, 209, 122, 0.35), 0 12px 36px rgba(0, 0, 0, 0.85);
      background: linear-gradient(160deg, #3d1b46, #140924);
      transition: transform .3s ease, box-shadow .3s ease
    }

    .ram-photo-frame:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 45px rgba(247, 209, 122, 0.48), 0 16px 42px rgba(0, 0, 0, 0.9)
    }

    .ram-photo-frame img {
      display: block;
      width: 100%;
      height: auto;
      max-height: min(46vh, 360px);
      object-fit: cover;
      object-position: center 20%
    }

    .ram-photo-frame .caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(0deg, rgba(14, 7, 26, 0.95) 0%, rgba(14, 7, 26, 0.75) 75%, transparent 100%);
      border-top: 1px solid rgba(247, 209, 122, 0.35);
      padding: 10px 14px 8px;
      font: 13px Georgia, serif;
      letter-spacing: .06em;
      color: #ffe5a3;
      text-shadow: 0 2px 8px #000
    }

    #bg:after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, #05061155 0%, #08051188 55%, #08051166 100%);
      pointer-events: none
    }

    .screen {
      background: transparent
    }

    .puja {
      background: transparent
    }

    .fixed-photos .photo-box {
      overflow: hidden
    }

    .fixed-photos .fixed-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block
    }

    .fixed-photos .photo-caption {
      position: absolute;
      bottom: 7px;
      left: 7px;
      right: 7px;
      padding: 7px 8px;
      background: #120921d9;
      border: 1px solid #f7d17a77;
      border-radius: 10px;
      color: #ffe4a3;
      font: 11px Arial, sans-serif;
      letter-spacing: .04em
    }

    .aarti-wrap {
      height: 190px
    }

    .thali {
      position: relative;
      width: 176px;
      height: 176px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: radial-gradient(circle, #a95820 0%, #e7b75c 38%, #8a3e19 58%, #f4cf7d 64%, #7a3519 71%, #d9a64d 78%, #451b22 85%, transparent 86%);
      border: 5px ridge #f5d27c;
      box-shadow: 0 0 28px #ffbd4c99, inset 0 0 18px #ffe7a2;
      animation: rotateThali 5s linear infinite;
      transform-origin: center
    }

    .thali-ring {
      position: absolute;
      inset: 15px;
      border: 2px dotted #ffedb4;
      border-radius: 50%;
      box-shadow: inset 0 0 9px #ffd36a
    }

    .thali-flower {
      position: absolute;
      font-size: 25px;
      filter: drop-shadow(0 0 5px #ffca58)
    }

    .thali-flower.f1 {
      top: 20px;
      left: 45px
    }

    .thali-flower.f2 {
      top: 48px;
      right: 18px
    }

    .thali-flower.f3 {
      bottom: 24px;
      right: 42px
    }

    .thali-flower.f4 {
      bottom: 48px;
      left: 17px
    }

    .thali-diya {
      font-size: 57px;
      filter: drop-shadow(0 0 16px #ffdc75);
      z-index: 1
    }

    #s4 #afterAarti {
      display: inline-block !important;
      margin: 14px auto 24px;
      position: relative;
      z-index: 4
    }

    #s4 .aarti-wrap {
      margin: 12px auto
    }

    #s4 .audio-note {
      max-width: 90%;
      text-align: center
    }

    .diya-page {
      background: transparent !important
    }

    .five-diyas {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: clamp(8px, 2.4vw, 28px);
      flex-wrap: wrap;
      margin: clamp(18px, 4vh, 38px) auto
    }

    .diya-touch {
      width: clamp(58px, 12vw, 104px);
      height: clamp(76px, 14vw, 120px);
      border: 1px solid #f7d17a88;
      border-radius: 20px;
      background: linear-gradient(180deg, #14091eaa, #3a1b2baa);
      font-size: clamp(2.4rem, 6vw, 4.2rem);
      cursor: pointer;
      filter: grayscale(.8) brightness(.62);
      transition: transform .35s, filter .35s, box-shadow .35s;
      touch-action: manipulation
    }

    .diya-touch.lit {
      filter: grayscale(0) brightness(1.22);
      transform: translateY(-5px);
      box-shadow: 0 0 25px #ffc84b99, 0 0 50px #ff9d3655;
      animation: diyaFlicker 1.6s ease-in-out infinite alternate
    }

    .diya-touch:active {
      transform: scale(.94)
    }

    @keyframes diyaFlicker {
      from {
        filter: brightness(1.05) drop-shadow(0 0 8px #ffbc4a)
      }

      to {
        filter: brightness(1.35) drop-shadow(0 0 20px #ffd45c)
      }
    }

    .diya-instruction,
    .diya-count {
      font-size: clamp(1.1rem, 3vw, 1.45rem);
      text-shadow: 0 2px 10px #000
    }

    #continueDiyas:disabled {
      opacity: .48;
      cursor: not-allowed
    }

    #s4 .thali {
      animation: rotateThali 3.8s linear infinite
    }

    .music-toggle {
      position: fixed;
      top: 14px;
      right: 16px;
      z-index: 30;
      background: #180c2ee6;
      border: 1px solid #f7d17a99;
      border-radius: 999px;
      padding: 7px 14px;
      font: 12px Arial, sans-serif;
      letter-spacing: .05em;
      color: #ffe5a3;
      cursor: pointer;
      backdrop-filter: blur(6px);
      box-shadow: 0 0 15px rgba(247, 209, 122, 0.2);
      transition: all .25s ease
    }

    .music-toggle:hover {
      transform: scale(1.05);
      box-shadow: 0 0 22px rgba(247, 209, 122, 0.4)
    }

    .music-toggle.muted {
      opacity: .65;
      border-color: #a89aa0;
      color: #d0c6cd
    }

    .rangoli-panel {
      max-width: 980px
    }

    .rangoli-wrapper {
      width: min(88vw, 360px);
      height: min(88vw, 360px);
      margin: 6px auto;
      border-radius: 28px;
      background: radial-gradient(circle, #28133b 0%, #120822 68%, #080410 100%);
      border: 2px solid #f7d17a88;
      box-shadow: 0 0 35px rgba(247, 209, 122, 0.22), 0 10px 30px rgba(0, 0, 0, 0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px;
      touch-action: manipulation
    }

    .rangoli-wrapper svg {
      width: 100%;
      height: 100%;
      overflow: visible
    }

    .rangoli-part {
      cursor: pointer;
      transition: fill .3s ease, filter .3s ease
    }

    .rangoli-part:hover {
      filter: brightness(1.28) drop-shadow(0 0 7px #ffd76a)
    }

    .rangoli-part:active {
      transform: scale(0.98)
    }

    .rangoli-part.selected-target {
      stroke: #ffffff !important;
      stroke-width: 2.5 !important;
      filter: drop-shadow(0 0 9px #ffffff)
    }

    .rangoli-palette {
      display: flex;
      gap: clamp(8px, 2vw, 12px);
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      margin: 6px auto 6px;
      max-width: 440px
    }

    .color-swatch {
      width: clamp(28px, 6.8vw, 35px);
      height: clamp(28px, 6.8vw, 35px);
      border-radius: 50%;
      border: 2px solid #ffffff44;
      cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
      touch-action: manipulation
    }

    .color-swatch:hover {
      transform: scale(1.15)
    }

    .color-swatch.active {
      transform: scale(1.22);
      border-color: #ffffff;
      box-shadow: 0 0 16px var(--swatch-color, #ffd700), 0 0 4px #fff
    }

    .rangoli-controls {
      display: flex;
      gap: 8px;
      justify-content: center;
      flex-wrap: wrap;
      margin: 2px auto 6px
    }

    .rangoli-btn {
      border: 1px solid #f7d17a77;
      color: #ffe4a3;
      background: #1b0d2daa;
      border-radius: 999px;
      padding: 6px 13px;
      font: 11.5px Arial, sans-serif;
      letter-spacing: .04em;
      cursor: pointer;
      transition: .2s
    }

    .rangoli-btn:hover {
      background: #f7d17a22;
      border-color: #f7d17a
    }

    .rangoli-btn.active {
      background: linear-gradient(120deg, #9c6724, #e8bd61);
      color: #1f0c2a;
      font-weight: bold;
      border-color: #ffd76a
    }

    @media(max-width:600px) {
      .panel {
        min-height: calc(100svh - 20px);
        padding: 10px 8px
      }

      .photo-box {
        width: 42vw;
        height: 43vw;
        min-height: 145px
      }

      .btn {
        padding: 10px 15px;
        font-size: 12px
      }

      .photo-row {
        gap: 8px
      }

      .offer {
        height: 72px
      }

      .hand,
      .sunflower {
        font-size: 42px
      }

      .ram-photo-card {
        margin: 8px auto;
        width: 95vw
      }

      .ram-photo-frame img {
        max-height: min(30vh, 210px)
      }

      .ram-photo-frame .caption {
        font-size: 10.5px;
        padding: 5px 6px;
        letter-spacing: .02em
      }

      .music-toggle {
        top: 8px;
        right: 10px;
        padding: 4px 9px;
        font-size: 10px
      }

      .rangoli-wrapper {
        width: min(76vw, 260px);
        height: min(76vw, 260px);
        margin: 3px auto;
        padding: 3px
      }

      .rangoli-palette {
        gap: 5px;
        margin: 3px auto 4px
      }

      .color-swatch {
        width: 24px;
        height: 24px
      }

      .rangoli-controls {
        gap: 4px;
        margin: 2px auto 4px
      }

      .rangoli-btn {
        padding: 4px 8px;
        font-size: 10px
      }

      .rangoli-instruction {
        font-size: 0.85rem !important;
        line-height: 1.3 !important;
        margin: 2px auto 3px !important
      }

      #s2 h2 {
        margin: 3px 0 2px !important;
        font-size: 1.6rem !important
      }

      #rangoliStatus {
        margin: 3px auto 5px !important;
        font-size: 0.78rem !important
      }
    }
  </style>
</head>

<body>
  <audio id="bgMusic" src="alo-amar-alo-ogo.mp3" loop preload="auto"></audio>
  <audio id="pujaMusic" src="eso-ma-lokkhi-boso-ghore.mp3" loop preload="auto"></audio>
  <button id="musicToggle" class="music-toggle" onclick="toggleMute()" aria-label="Toggle festive music">🎵 Music:
    On</button>

  <div id="bg"></div><canvas id="stars"></canvas><canvas id="fx"></canvas>

  <!-- Screen 0: Opening / Ram Darbar -->
  <div class="screen active" id="s0">
    <div class="panel ram-opening">
